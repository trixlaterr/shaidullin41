<Page x:Class="_41.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_41"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductPage" FontFamily="Comic Sans MS">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"></ColumnDefinition>
                    <ColumnDefinition Width="300"></ColumnDefinition>
                    <ColumnDefinition Width="300"></ColumnDefinition>
                    <ColumnDefinition Width="1000"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="75"></RowDefinition>
                    <RowDefinition Height="75"></RowDefinition>
                </Grid.RowDefinitions>
                <StackPanel Margin="10" Orientation="Vertical" HorizontalAlignment="Right"  Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2" Grid.RowSpan="2">
                    <Button Name="OrderBtn" Width="300" Content="Корзина" Click="OrderBtn_Click"></Button>
                    <TextBlock Name="FIOTB" FontSize="15"></TextBlock>
                    <TextBlock Name="RoleTB" FontSize="15"></TextBlock> 
                </StackPanel>
                



                <TextBlock Name="TBAllCount" Grid.Column="0" Grid.Row="1" Text="Количество 0 из 0" VerticalAlignment="Center" TextAlignment="Right" Width="150" FontSize="15"></TextBlock>
            
                


                <StackPanel Margin="10" Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="1" Grid.Row="1">
                
                    <TextBlock Text="Введите название для поиска " TextAlignment="Center" Width="250" FontSize="15"></TextBlock>
                    <TextBox Name="TBoxSearch" TextChanged="TBoxSearch_TextChanged" Width="250" FontSize="15"></TextBox>
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="2" Grid.Row="1">
                    
                    <RadioButton Content="По возрастанию стоимости" GroupName="Sort" Width="300" FontSize="15" Name="RButtonUp" Checked="RButtonUp_Checked"></RadioButton>
                    <RadioButton Content="По убыванию стоимости" GroupName="Sort" Width="300" FontSize="15" Name="RButtonDown" Checked="RButtonDown_Checked"></RadioButton>
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="3" Grid.Row="1">
                    <TextBlock Text="Фильтрация по скидке" TextAlignment="Center" Width="200" FontSize="15"></TextBlock>
                    <ComboBox Name="ComboType" SelectionChanged="ComboType_SelectionChanged" FontSize="15" Width="200">
                        <TextBlock>Все</TextBlock>
                        <TextBlock>0-9,99%</TextBlock>
                        <TextBlock>10-14,99%</TextBlock>
                        <TextBlock>15-100%</TextBlock>
                    </ComboBox>

                

                </StackPanel>
                
            </Grid>

        </WrapPanel>


        <ListView Name="ProductListView" Grid.Row="2"  HorizontalContentAlignment="Stretch" PreviewMouseRightButtonDown="ProductListView_PreviewMouseRightButtonDown">
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Добавить к заказу" Click="MenuItem_Click"></MenuItem>
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            
                        </Grid.RowDefinitions>

                        <Image Width="120" Height="120" Grid.Column="0" Grid.RowSpan="4" Stretch="Fill">
                            <Image.Source>
                                <Binding Path="ProductImageFull">
                                    <Binding.TargetNullValue>
                                        <ImageSource>
                                            logo/picture.png
                                        </ImageSource>
                                    </Binding.TargetNullValue>
                                </Binding>
                            </Image.Source>
                        </Image>

                        <TextBlock Text="{Binding ProductName}" FontWeight="Bold" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left" FontSize="16" Margin="5,0,0,10"></TextBlock>
                        <TextBlock Text="{Binding ProductCost}" Grid.Column="1" Grid.Row="3" HorizontalAlignment="Left" FontSize="16" Margin="5,0,0,5"></TextBlock>
                        <TextBlock Text="{Binding ProductManufactrurer}" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Left" FontSize="16" Margin="5,0,0,5"></TextBlock>
                        <TextBlock Text="{Binding ProductDescription}" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left" FontSize="16" Margin="5,0,0,5"></TextBlock>
                        <TextBlock Text="{Binding ProductDiscountAmount, StringFormat={}{0}%}" Grid.Column="2" Grid.Row="1" Grid.RowSpan="3"  HorizontalAlignment="Center"  VerticalAlignment="Center" FontSize="26"></TextBlock>
                        <TextBlock Text="Скидка" Grid.Column="2" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Bottom"></TextBlock>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>


    </Grid>
</Page>
