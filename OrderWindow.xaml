<Window x:Class="_41.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_41"
        mc:Ignorable="d"
        Title="OrderWindow" Height="450" Width="800" FontFamily="Comic Sans MS" FontSize="14">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition Height="30"></RowDefinition>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Дата формирования заказа" TextAlignment="Left" ></TextBlock>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Дата доставки заказа" TextAlignment="Left" ></TextBlock>
        <TextBlock Grid.Row="2" Grid.Column="0" Text="ФИО клиента" TextAlignment="Left" ></TextBlock>
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Номер заказа" TextAlignment="Left" ></TextBlock>
        <TextBlock Grid.Row="5" Grid.Column="0" Text="Пункт выдачи" TextAlignment="Left" ></TextBlock>
        <DatePicker Name="OrderDP" Grid.Row="0" Grid.Column="1"></DatePicker>
        <DatePicker Name="DeliveryDP" Grid.Row="1" Grid.Column="1"></DatePicker>
        <TextBlock Name="FIOTB" Grid.Row="2" Grid.Column="1"></TextBlock>
        <TextBlock Name="OrderIDTB" Grid.Row="3" Grid.Column="1"></TextBlock>
        <ComboBox Name="PickUpPointCB" Grid.Column="1" Grid.Row="5">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock>
                <Run Text="{Binding PickUpPointIndex}"/>, г.<Run Text="{Binding PickUpPointCity}"/>,
                ул.<Run Text="{Binding PickUpPointStreet}"/>, д.<Run Text="{Binding PickUpPointHome}"/>
                    </TextBlock>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <ListView Name="OrderListView" Grid.Row="4" Grid.ColumnSpan="2">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Width="80" Height="80" Source="{Binding Product.ProductImageFull}"/>
                        <StackPanel Grid.Column="1" Margin="5,0">
                            <TextBlock Text="{Binding Product.ProductName}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Product.ProductManufactrurer}"/>
                            <TextBlock Text="{Binding Product.ProductDescription}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding Product.ProductCost, StringFormat={}{0:N2} ₽}"/>
                            <TextBlock Text="{Binding Product.ProductDiscountAmount, StringFormat=Скидка {0}%}"/>
                        </StackPanel>
                        <StackPanel  Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="6" Grid.ColumnSpan="6">
                            <Button Width="40" Height="40" Content="−" Click="MinusBtn_Click" 
                        VerticalAlignment="Center" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Quantity}" FontSize="18"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Button Width="40" Height="40" Content="+" Click="PlusBtn_Click"
                        VerticalAlignment="Center" FontWeight="Bold"/>
                            <Button Width="100" Height="40" Content="Удалить" Click="DeleteBtn_Click"
                        VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>

                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Button Grid.Column="1" Grid.Row="6" Content="Сохранить" Name="SaveBtn" Click="SaveBtn_Click"></Button>
        <StackPanel Orientation="Horizontal" Grid.Row="7" Grid.Column="1" HorizontalAlignment="Right">
            <TextBlock Name="TotalSumTB"></TextBlock>
            <TextBlock Name="DiscountTB" Margin="15,0,0,0"></TextBlock>
            <TextBlock Name="TotalWithDiscountTB" Margin="15,0,0,0"></TextBlock>
        </StackPanel>
    </Grid>
</Window>
