<Page x:Class="_41.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_41"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="500"
      Title="AuthPage" FontFamily="Comic Sans MS" FontSize="20">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Логин" Grid.Row="0"  Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="30"></TextBlock>
        <TextBlock Text="Пароль" Grid.Row="1"  Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="30"></TextBlock>
        <TextBox Name="LoginTB" Grid.Row="0" Grid.Column="1" Width="200" Height="50"></TextBox>
        <TextBox Name="PasswordTB"  Grid.Row="1" Grid.Column="1" Width="200" Height="50"></TextBox>
        <Button Name="LoginGuest_Btn" Content="Войти как гость"  Grid.Row="3" Grid.Column="0" Click="LoginGuest_Btn_Click"></Button>
        <Button Name="Login_Btn" Content="Войти" Grid.Row="3" Grid.Column="1" Click="Login_Btn_Click"></Button>
        <TextBox Name="CaptchacheckTB" Visibility="Collapsed" Grid.Row="2" Grid.Column="1" Height="50" Width="200"  HorizontalAlignment="Center"></TextBox>
        <StackPanel Name="CaptchaSP" Grid.Row="2" Visibility="Collapsed" HorizontalAlignment="Center">
            <TextBlock Name="captchaOneWord" FontSize="22" Margin="30,0,0,0"></TextBlock>
            <TextBlock Name="captchaTwoWord" FontSize="22" TextDecorations="Strikethrough" Margin="0,5,0,0"></TextBlock>
            <TextBlock Name="captchaThreeWord" FontSize="22" TextDecorations="Strikethrough"></TextBlock>
            <TextBlock Name="captchaFourWord" FontSize="22" TextDecorations="Strikethrough" Margin="0,10,0,0"></TextBlock>
        </StackPanel>

        
    </Grid>
</Page>
